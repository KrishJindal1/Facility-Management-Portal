# Application Environment (development, staging, production)
APP_ENV=development

# Server Port (Render injects PORT automatically; default is 8501 for local dev)
PORT=8501

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example: postgresql://postgres:postgres@localhost:5432/facility_management
# Defaults to local sqlite database in data/ if not specified in development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/facility_management

# Storage Configuration
# Path to requirements Excel export file (defaults to data/requirements.xlsx inside project root)
# EXCEL_FILE_PATH=data/requirements.xlsx

# Knowledge Base Directory
# Path to domain knowledge documents (defaults to knowlegde/ inside project root)
# KNOWLEDGE_DIR=knowlegde

# AI Provider Configuration
# Supported providers: openai, gemini, ollama
AI_PROVIDER=openai

# Cloud AI API Key (required for cloud deployment on Render)
# Can be OpenAI key, Groq key, OpenRouter key, or Gemini key
AI_API_KEY=your-cloud-ai-api-key-here

# Cloud AI Model (e.g. gpt-4o-mini, llama-3.3-70b-versatile, gemini-1.5-flash)
AI_MODEL=gpt-4o-mini

# Optional Custom Endpoint URL (e.g. for Groq: https://api.groq.com/openai/v1)
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_SECONDS=30

# Local Ollama Configuration (only active when AI_PROVIDER=ollama for local dev)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

